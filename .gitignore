#A) .gitignore raíz (repo)

#Incluye IDEs, secretos globales, OS temp, node_modules globales, build comunes.
#Contenido sugerido para el archivo raíz .gitignore:


# Sistema / OS
.DS_Store
Thumbs.db

# IDEs
.vs/
.vscode/
.idea/

# Node (Frontend)
Frontend.Votapp/node_modules/
Frontend.Votapp/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# .NET secretos/locales
.env
.env.local
.env.*.local
**/appsettings.Local.json
**/appsettings.Development.json
**/launchSettings.json

# Dotnet caches
.nuget/
*.nupkg

# Logs
logs/
*.log

# Build outputs
**/bin/
**/obj/
dist/
build/
out/
