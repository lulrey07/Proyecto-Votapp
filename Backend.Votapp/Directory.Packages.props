<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Central package versions: ajustar según compatibilidad y cambios de release -->
  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />

    <!-- MySQL provider (Pomelo) - elegir versión compatible con EF Core -->
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.0" />

    <!-- Validation, Mapping, MediatR -->
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.6.0" />
    <PackageVersion Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
    <PackageVersion Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="10.0.0" />

    <!-- Authentication & Authorization -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="4.0.0" />

    <!-- Swagger / OpenAPI -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.4.0" />

    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.4.2" />
    <PackageVersion Include="Moq" Version="4.18.4" />
    <PackageVersion Include="FluentAssertions" Version="6.11.0" />
  </ItemGroup>

  <!-- Nota:
       - Estas versiones son SUGERIDAS. Antes de fijarlas, ejecuta "dotnet restore" y "dotnet build".
       - Ajusta las versiones según la compatibilidad de tu SDK (.NET 9) y del provider MySQL.
       - Para fijar versiones en toda la solución, este archivo centraliza los PackageVersion.
  -->
</Project>
